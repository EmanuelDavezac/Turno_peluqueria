# Copiar a .env.local. Solo claves PÚBLICAS (todo lo que empieza con VITE_ llega al navegador).
# NUNCA poner acá la secret key / service_role ni la contraseña de la base.

# "local" = demo con localStorage (default). "supabase" = datos reales.
VITE_BACKEND=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
